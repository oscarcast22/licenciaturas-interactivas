---
import { ClientRouter } from 'astro:transitions';
import 'select2/dist/css/select2.min.css';
import '@fontsource-variable/montserrat';
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	/* Variables Globales */
	:root {
	/* Colores */
	--black: #161616;
	--gray-100: #1a1a1a;
	--gray-300: #737373;
	--gray-500: #c9c9c9;
	--gray-600: #e8e8e8;
	--gray-900: #f2f2f2;
	--gray-950: #fff;
	--red-100: #940124;
	--red-200: #c10230;
	--surface: #fff;
	--surface-muted: #f2f2f2;
	--ink-muted: #666;
	--page-width: 1200px;
	--shadow-lg: 0 18px 45px rgb(0 0 0 / 18%);
	--link-color: #29a9e0;
	--link-hover-color: #fff;

	/* Tamaño de fuentes*/
	--text-xs: 0.75rem;
	--text-sm: 0.9rem;
	--text-base: 1rem;
	--text-md: 1.125rem;
	--text-lg: 1.25rem;
	--text-xl: 1.625rem;
	--text-2xl: 2.125rem;
	--text-3xl: 2.625rem;
	--text-4xl: 3.5rem;
	--text-5xl: 4.5rem;
	}

	body {
		font-family: 'Montserrat Variable', Montserrat, sans-serif;
	}

	button {
		transition: background-color .3s ease;
	}

	a {
		transition: background-color .3s ease;
	}
</style>

<script>
	document.addEventListener('astro:page-load', function() {
	    const OFFSET = 95;

	    const hash = window.location.hash;
	    if (hash) {
	        const targetElement = document.querySelector(hash);
	        if (targetElement) {
	            setTimeout(() => {
	                const targetPosition = targetElement.getBoundingClientRect().top + window.pageYOffset - OFFSET;
	                window.scrollTo({
	                    top: targetPosition,
	                    behavior: 'smooth'
	                });
	            }, 150);
	        }
	    }
	});
</script>
