---
interface Props {
    color: string;
}

const { color } = Astro.props;
---

<section class="perfil-egreso">
    <h1 style={`color: ${color}`}>
        Perfil Egreso
    </h1>
    <slot />
</section>

<style is:global>
    .perfil-egreso {
        color: var(--ink-muted);
        font-size: var(--text-base);
        line-height: 19px;
    }

    .perfil-egreso ul {
        margin: 0 0 19px;
        padding: 0;
    }

    .perfil-egreso li {
        margin: 0 0 19px;
    }

    .perfil-egreso li:last-child {
        margin-bottom: 0;
    }

    .perfil-egreso li::before { content: "- "; }

    .perfil-egreso h1 {
        margin: 2.5rem 0 1.25rem;
        font-size: clamp(var(--text-2xl), 4vw, var(--text-3xl));
        font-weight: 500;
    }

    .perfil-egreso h2 {
        margin: 19px 0;
        color: #333;
        font-size: var(--text-base);
        font-weight: 700;
        line-height: 19px;
    }

    .perfil-egreso h3 {
        margin: 19px 0;
        color: #333;
        font-size: var(--text-base);
        font-weight: 700;
        line-height: 19px;
    }

    .perfil-egreso p {
        margin: 0 0 19px;
        color: var(--ink-muted);
    }
</style>
