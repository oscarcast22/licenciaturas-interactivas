---
interface Props {
    color: string;
}

const { color } = Astro.props;
---

<section 
    class="perfil-egreso"
>
    <h1 style={`color: ${color}`}>
        Perfil Egreso
    </h1>
    <slot />
</section>

<style is:global>
    .perfil-egreso {
        color: var(--ink-muted);
        font-size: var(--text-base);
        line-height: 1.55;
    }

    .perfil-egreso ul {
        margin: 0 0 1.5rem;
        padding: 0;
    }

    .perfil-egreso li {
        margin: 0 0 .75rem;
    }

    .perfil-egreso li::before { content: "- "; }

    .perfil-egreso h1 {
        margin: 2.5rem 0 1.25rem;
        font-size: clamp(var(--text-2xl), 4vw, var(--text-3xl));
        font-weight: 500;
    }

    .perfil-egreso h2 {
        margin: 2.5rem 0 1rem;
        color: var(--black);
        font-size: var(--text-xl);
        font-weight: 600;
    }

    .perfil-egreso h3 {
        margin: 1.5rem 0 .75rem;
        color: var(--black);
        font-size: var(--text-md);
        font-weight: 600;
    }

    .perfil-egreso p {
        margin: 0 0 1.25rem;
        color: var(--ink-muted);
    }
</style>
