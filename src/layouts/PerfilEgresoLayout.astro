---
interface Props {
    color: string;
}

const { color } = Astro.props;
---

<section 
    class="perfil-egreso"
>
    <h1 style={`color: ${color}`}>
        Perfil Egreso
    </h1>
    <slot />
</section>

<style is:global>
    .perfil-egreso ul {
        padding: 0;
    }

    .perfil-egreso li {
        margin: .7em 0;
    }

    .perfil-egreso li:before{content: "- "}

    .perfil-egreso h1 {
		font-weight: 500;
		margin: 1.5em 0 .5em;
        font-size: clamp(2rem, 4vw, 3.25rem);
	}

    .perfil-egreso h3 {
        font-weight: 550;
    }

    .perfil-egreso p { color: var(--ink-muted); }
</style>
