---
import SocialMediaIcons from "../components/utils/SocialMediaIcons.astro";
import LogoLiColor from "../components/utils/LogoLiColor.astro";
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.astro";
---

<Layout title="Contacto">
    <section class="contacto" transition:animate="slide">
        <aside class="aside-image" >
            <img src="/images/contacto.jpg" alt="">
            <div class="head-text">
                <h1 style="font-weight: 500;">La opción</h1>
                <h1>A la Excelencia</h1>
            </div>
        </aside>
        <aside class="form-section">
            <a class="back-btn" href="/">
                <svg  aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m15 19-7-7 7-7"/>
                </svg>
                <p>Regresar</p>
            </a>
            <div class="form-logo">
                <a class="svg-logo" href="/">
                    <LogoLiColor />
                </a>
            </div>
            <div class="form-container">
                <ContactForm />
                <div class="footer" >
                    <SocialMediaIcons color="#a4a4a4" width="30px"/>
                    <hr>
                    <p>Avenida Universidad Autónoma de Durango #300</p>
                    <p>Colonia Jardines de Durango. Durango, Durango, México.</p>
                    <p>Teléfono: (618) 129-5901 Ext. 100</p>
                    <p>Whatsapp: 618 110 2529</p>
                </div>
            </div>
        </aside>
    </section>
</Layout>

<style>
    .contacto {
        display: flex;
        flex-wrap: wrap;
        min-height: 100vh;
    }

    .aside-image {
        flex: 0 0 45%;
        position: relative;
        overflow: hidden;
    }

    .form-section {
        flex: 0 0 55%;
        box-sizing: border-box;
        box-shadow: -10px 0 30px rgb(0 0 0 / 15%);
        position: relative;
    }

    .aside-image img {
        position: absolute;
        z-index: -1;
        object-fit: cover;
        height: 100%;
        width: 100%;
    }

    .head-text {
        position: absolute;
        width: max-content;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: left;
    }

    .head-text h1 {
        font-size: clamp(2rem, 4vw, 3.75rem);
        color: var(--gray-900);
        text-transform: uppercase;
        margin: 0;
        transition: all .3s;
    }

    .back-btn {
        text-decoration: none;
        position: absolute;
        top: 10px;
        left: 10px;
        display: flex;
        align-items: center;
        color: black;

        p {
            margin: 0;
            font-size: .8rem;
        }
    }

    .form-container {
        max-width: 620px;
        padding: 0 24px 2rem;
        min-height: calc(100% - 250px);
        margin: auto;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .footer {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .footer p {
        font-size: .9rem;
        margin: 0;
        color: #a4a4a4;
        text-align: center;
    }

    hr {
        color: #a4a4a4;
        width: 100%;
        margin: 40px;
    }

    .form-logo {
        display: flex;
        width: 100%;
        height: 180px;
    }

    .form-logo a {
        margin: auto;
        display: flex;
        max-width: 80%;
        transition: width .5s;
    }

    @media (max-width: 900px) {
        .contacto {
            flex-direction: column;
            height: auto;
        }

        .aside-image {
            order: -1;
            flex: 1 1 100%;
            min-height: 25vh;
        }

        .aside-image img {
            object-position: 50% 90%;
        }

        .form-section {
            flex: 1 1 100%;
            z-index: 99;
            background: var(--gray-900);
            box-shadow: -1px -6px 7px 0px rgb(0 0 0 / 30%);
        }
    }

    @media (max-width: 1180px) {
        .head-text h1 {
            font-size: 2rem;
        }
    }

    @media (max-width: 350px) {
        .head-text h1 {
            font-size: 1.6rem;
        }
    }

    @media (max-width: 300px) {
        .head-text h1 {
            font-size: 1.3rem;
        }
    }
</style>

<style is:global>
    .svg-logo svg {
        width: 350px;
        transition: all .3s;
    }

    @media (max-width: 360px) {
        .svg-logo svg {
            width: 250px;
        }
    }

</style>

<script>
    document.addEventListener('astro:page-load', function() {
        const imageAside = document.querySelector('.aside-image') as HTMLElement;
        if (imageAside) {
            function handleScroll() {
                const scrollPosition = window.scrollY;
                const imageBottom = imageAside.offsetTop;
                if (scrollPosition >= imageBottom) {
                    const distanceFromBottom = scrollPosition - imageBottom;
                    const parallaxValue = distanceFromBottom * 0.7;
                    imageAside.style.transform = `translateY(${parallaxValue}px)`;
                }
            }
        
            function checkViewport() {
                if (window.innerWidth <= 900) {
                    window.addEventListener('scroll', handleScroll);
                } else {
                    window.removeEventListener('scroll', handleScroll);
                    imageAside.style.transform = 'none';
                }
            }
        
            checkViewport();
            window.addEventListener('resize', checkViewport);
        }
    });
</script>
