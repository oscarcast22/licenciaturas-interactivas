---
import Layout from "../layouts/Layout.astro"
import Nav from "../components/Nav.astro"
import AccordionFAQs from "../components/AccordionFAQs.astro";
import BottomBanner from "../components/BottomBanner.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Preguntas frecuentes">
    <Nav />
    <div class="container" id="hero-faqs">
        <img src="/images/portada-preguntas-frecuentes.jpg" alt="">
        <h1
        >
            Preguntas <strong>Frecuentes</strong>
        </h1>
    </div>
    <main>
        <section>
            <AccordionFAQs />
            <BottomBanner />
        </section>
        <Footer />
    </main>
</Layout>

<style>
    .container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        text-align: center;
        z-index: 0;
        height: min(590px, 70vh);
    }

    .container img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: 50% 10%;
    }

    .container h1 {
        position: absolute;
        color: var(--gray-950);
        font-size: clamp(2.5rem, 6vw, 5rem);
        font-weight: 500;
        margin: 0 1rem;
    }

    main {
        background: var(--gray-900);
		position: relative;
		z-index: 1;
        margin-top: min(590px, 70vh);
    }

    section {
        margin: auto;
        padding: 3rem 24px 7rem;
		max-width: var(--page-width);
    }

    @media (max-width: 485px) {
        .container h1 {
            font-size: var(--text-4xl);
        }
    }

    @media (max-width: 355px) {
        .container h1 {
            font-size: var(--text-3xl);
        }
    }
</style>
