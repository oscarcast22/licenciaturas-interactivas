---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Gracias por contactarnos">
    <section transition:animate="slide">
        <div class="centered-content">
            <h1>Gracias por contactarnos</h1>
            <p>Nuestro equipo se pondra en contacto contigo a la brevedad</p>
            <a href="/">Volver a inicio</a>
        </div>
    </section>
</Layout>

<style>
    .centered-content {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        text-align: center;
        padding: 2rem;
        background: linear-gradient(135deg, var(--gray-100), #343434);
        color: var(--gray-950);
    }
    
    .centered-content h1 { font-size: clamp(2rem, 5vw, 4rem); margin: 0; }
    .centered-content p { color: var(--gray-500); max-width: 42rem; }
    .centered-content a {
        background: var(--red-200); color: var(--gray-950); border-radius: 999px;
        padding: .75rem 1.25rem; text-decoration: none; font-weight: 600;
    }

    .centered-content div {
        max-width: 600px;
        padding: 20px;
    }
    </style>
