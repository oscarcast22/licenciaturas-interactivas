---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import DegreeDetailPage from '../../components/DegreeDetailPage.astro';

interface Props {
	entry: CollectionEntry<'licenciaturas'>;
}

export async function getStaticPaths() {
	const licenciaturas = await getCollection('licenciaturas');
	return licenciaturas.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}


const { entry } = Astro.props;
const { Content } = await render(entry);

---

<DegreeDetailPage
	title={entry.data.titulo}
	portada={entry.data.portada}
	portadaAlt={entry.data.portada_alt}
	color={entry.data.color}
	resumen={entry.data.resumen}
	planEstudios={entry.data.plan_estudios}
>
	<Content />
</DegreeDetailPage>
