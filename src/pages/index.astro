---
import { getCollection } from 'astro:content';
import Hero from "../components/Hero.astro";
import HeroContent from "../components/HeroContent.astro";
import Nav from "../components/Nav.astro";
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro"
import BottomHero from "../components/BottomHero.astro";
import CollectionCard from "../components/CollectionCard.astro";
import TextReveal from '../components/TextReveal.astro';

const licenciaturas = (await getCollection('licenciaturas'));
---

<Layout title="Licenciaturas Interactivas" page="home">
	<main>
		<Nav />
		<Hero
			title="Licenciaturas Interactivas"
			subtitle="Las licenciaturas Interactivas cuentan con un Plan de Estudios compuesto de 9 a 10 cuatrimestres integrados en 9 bloques de 6 materias cada uno. Por lo que puedes concluir tu carrera en 3 años."
			img1="/images/hero/portada-lic-interactivas.jpg"
		/>
		<section class="main-section">
			<div class="intro-wrap">
				<HeroContent />
			</div>
			<div class="collections-wrap">
				<div class="max-w">
					<CollectionCard 
						title="Licenciaturas"
    					imageUrl="/images/portada-licenciaturas-li.jpg"
    					textAlign="right"
						id="licenciaturas"
    					items={licenciaturas}
					/>
				</div>
			</div>
			<TextReveal text="Educación a tu ritmo de vida" />

			<section class="bottom-section">
				<BottomHero 
					title="¡Únete a la Gran Familia Lobos!"
					img1="/images/hero/portada-lic-interactivas.jpg"
				/>
				<Footer />
			</section>
		</section>
	</main>
</Layout>

<style>
	.main-section {
		--home-card-overlap: 134px;
		background: linear-gradient(180deg, rgb(242 242 242 / 0%) 0, var(--surface-muted) 15rem);
		position: relative;
		z-index: 1;
		margin-top: 1083px;
		background: var(--surface);
	}

	.bottom-section {
		position: relative;
	}

	.max-w {
		padding: 0 20px;
		max-width: 1034px;
		margin: auto;
	}

	.intro-wrap {
		padding: 0 20px;
		position: relative;
		transform: translateY(calc(-1 * var(--home-card-overlap)));
		margin-bottom: calc(-1 * var(--home-card-overlap));
	}
	.collections-wrap { overflow: hidden; padding-bottom: 3rem; }

	@media (max-width: 800px) {
		.main-section {
			--home-card-overlap: 60px;
			margin-top: min(100svh, 700px);
		}
	}
</style>
