---
import SocialMediaIcons from "./utils/SocialMediaIcons.astro";
---

<footer>
    <div class="max-w">
        <aside>
            <div class="info">
                <img class="logo" src="/images/logo-li-blanco.svg" alt="Logo">
                <div class="direccion">
                    <p>Avenida Universidad Autonoma de Durango #300</p>
                    <p>Colonia Jardines de Durango. Durango, Durango, México</p>
                    <p>Teléfono(s) (618) 129-57-86 (618) 129-5901</p>
                </div>
            </div>
        </aside>
        <aside>
           <div class="links">
                <ul class="link">
                    <li>
                        <a href="/#licenciaturas">Licenciaturas</a>
                    </li>
                    <li>
                        <a href="/#maestrias">Maestrias</a>
                    </li>
                    <li>
                        <a href="/#doctorados">Doctorados</a>
                    </li>
                    <li>
                        <a href="/preguntas_frecuentes">Preguntas Frecuentes</a>
                    </li>
                    <li>
                        <a href="/contacto">Contacto</a>
                    </li>
                </ul>
                <SocialMediaIcons color="var(--gray-900)" width="30px"/>
           </div>
        </aside>
    </div>
</footer>

<style>
    aside {
        width: 50%;
    }

    footer {
        background-color: var(--gray-100);
        color: var(--gray-900);
    }

    footer::after {
        content: '';
        position: absolute;
        width: 100%;
        height: 5px;
        background: var(--red-200);
    }

    .info {
        display: grid;
        gap: 15px;
    }

    .logo {
        width: 260px;
        height: auto;
    }

    .direccion p {
        margin: 5px;
        font-weight: 300;
        font-size: 1REM;
    }

    .links {
        display: flex;
        justify-content: space-between;
        margin-left: 15px;
        gap: 10px;
    }

    .links ul {
        margin: 0;
        padding: 0;
    }

    .link a {
        color: #fff;
        font-weight: 300;
        text-decoration: none;
    }

    .link li {
        margin: 5px;
    }

    .link li a {
        transition: filter 0.3s;
    }

    .link li a:hover {
        filter: brightness(0.75);
    }

    .max-w {
        max-width: 1440px;
        display: flex;
        padding: 30px 20px;
        margin: auto;
    }

    .direccion a[x-apple-data-detectors] {
        color: inherit !important;
        text-decoration: none !important;
    }

    @media (max-width: 815px) {
        .max-w {
            flex-direction: column;
        }
        aside {
            width: 100%;
        }
        .logo {
            margin: 0 auto 10px;
        }
        .links {
            margin: 20px 0 0;
        }
    }

    @media (max-width: 490px) {
        .links {
            flex-direction: column;
            align-items: center;
        }
        .link {
            align-self: flex-start;
        }
    }
</style>