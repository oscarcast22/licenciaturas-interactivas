---
import CollapseButton from './utils/CollapseButton.astro';

interface Props {
    color: string;
    plan_estudios: {
        titulo?: string;
        contenido?: string[];
    }[];
}

const { color, plan_estudios } = Astro.props
---

<div 
    class="plan_estudios"
    data-motion-reveal
>
    <label for="button-collapse" class="title" style={`background-color: ${color};`}>
        <h2>Plan de Estudios</h2>
        <CollapseButton 
            inputName='button-collapse'
            width='22px'
            thickness='4px'
            color='var(--gray-900)'
        />
    </label>
    <div class="collapsible-content">
        <div class="grid-units">
            {plan_estudios.map((plan) => (
                <div class="grid-item">
                    <h3>{plan.titulo}</h3>
                    <ul>
                        {plan.contenido.map((item) => (
                            <li>{item}</li>
                        ))}
                    </ul>
                </div>
            ))}
        </div>
    </div>
</div>


<style>
    .title {
        margin-top: 4rem;
        cursor: pointer;
        padding: 1rem 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-radius: 14px;
        box-shadow: 0 10px 25px rgb(0 0 0 / 13%);
    }

    .title  h2 {
        color: var(--gray-900);
        margin: 0;
        font-size: clamp(1.55rem, 3vw, 2.2rem);
    }

    .grid-units {
        display: grid;
        margin: 0;
        padding: 2rem;
        grid-template-columns: 1fr 1fr 1fr;
        column-gap: 15px;
        row-gap: 1.5rem;
    }

    .grid-units h3 {
        color: var(--black);
        margin: 0;
        font-size: 17px;
        font-weight: 700;
        line-height: 24px;
    }

    .grid-item ul {
        margin: 0;
        padding: 0;
    }

    .grid-item li {
        margin: 0;
        color: var(--ink-muted);
        font-size: var(--text-base);
        line-height: 22px;
    }

    .grid-item li::before { content: "- "; }
    
    .collapsible-content {
        height: 0;
        overflow: hidden;
        transition: height var(--motion-expand) var(--ease-standard);
        background: var(--surface);
        border-radius: 0 0 14px 14px;
    }

    @media (max-width: 720px) {
        .grid-units {
            grid-template-columns: 1fr 1fr;
            grid-template-columns: 1fr 1fr;
            padding: 1.5rem;
        }
    }

    @media (max-width: 400px) {
        .grid-units {
            grid-template-columns: 1fr;
            padding: 1.25rem;
        }
    }

    @media (max-width: 430px) {
        .title h2 {
            font-size: 7.45vw;
        }
        .title {
            padding: 10px 15px;
        }
    }
</style>

<script>
    document.addEventListener('astro:page-load', () => {
        const checkbox = document.getElementById('button-collapse') as HTMLInputElement;
        const collapsibleContent = document.querySelector('.collapsible-content') as HTMLElement;

        if (checkbox && collapsibleContent) {
            checkbox.addEventListener('change', () => {
                if (checkbox.checked) {
                    collapsibleContent.style.height = `${collapsibleContent.scrollHeight}px`;
                } else {
                    collapsibleContent.style.height = '0';
                }
                });
            collapsibleContent.style.height = '0';
        }
    });
</script>
