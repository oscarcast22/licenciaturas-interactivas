---
import CollapseButton from './utils/CollapseButton.astro';

interface Props {
    color: string;
    plan_estudios: {
        titulo?: string;
        contenido?: string[];
    }[];
}

const { color, plan_estudios } = Astro.props
---

<div 
    class="plan_estudios"
    data-aos="zoom-in-up"
    data-aos-duration="550"
    data-aos-once="true"
>
    <label for="button-collapse" class="title" style={`background-color: ${color};`}>
        <h2>Plan de Estudios</h2>
        <CollapseButton 
            inputName='button-collapse'
            width='22px'
            thickness='4px'
            color='var(--gray-900)'
        />
    </label>
    <div class="collapsible-content">
        <div class="grid-units">
            {plan_estudios.map((plan) => (
                <div class="grid-item">
                    <h3>{plan.titulo}</h3>
                    <ul>
                        {plan.contenido.map((item) => (
                            <div style="display: flex;" >
                                - <li>{item}</li>
                            </div>
                        ))}
                    </ul>
                </div>
            ))}
        </div>
    </div>
</div>


<style>
    .title {
        margin-top: 70px;
        cursor: pointer;
        padding: 10px 25px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: padding .3s ease;
    }

    .title  h2 {
        color: var(--gray-900);
        margin: 0;
        font-size: 2em;
    }

    .grid-units {
        display: grid;
        margin: 20px 30px ;
        grid-template-columns: 1fr 1fr 1fr;
        column-gap: 15px;
        row-gap: 10px;
        transition: all 1s ease;
    }

    .grid-units h3 {
        margin: .8em 0 .8em 0;
    }

    .grid-item ul {
        padding: 0;
        display: flex;
        flex-direction: column;
    }

    .grid-item li {
        margin-bottom: .4em;
    }
    
    .collapsible-content {
        height: 0;
        overflow: hidden;
        transition: height .6s ease;
    }

    @media (max-width: 720px) {
        .grid-units {
            grid-template-columns: 1fr 1fr;
            margin: 15px 20px;
        }
    }

    @media (max-width: 400px) {
        .grid-units {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 430px) {
        .title h2 {
            font-size: 7.45vw;
        }
        .title {
            padding: 10px 15px;
        }
    }
</style>

<script>
    document.addEventListener('astro:page-load', () => {
        const checkbox = document.getElementById('button-collapse') as HTMLInputElement;
        const collapsibleContent = document.querySelector('.collapsible-content') as HTMLElement;

        if (checkbox && collapsibleContent) {
            checkbox.addEventListener('change', () => {
                if (checkbox.checked) {
                    collapsibleContent.style.height = `${collapsibleContent.scrollHeight}px`;
                } else {
                    collapsibleContent.style.height = '0';
                }
                });
            collapsibleContent.style.height = '0';
        }
    });
</script>