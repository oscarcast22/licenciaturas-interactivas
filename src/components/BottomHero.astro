---
interface Props {
	title: string;
    img1: string;
}

const { title, img1 } = Astro.props;
---
<section class="hero">
    <div class="viewport-image" aria-hidden="true">
        <img src={img1} alt="" />
    </div>
    <div class="hero-text" data-motion-reveal>
        <h1 data-motion-reveal-item>{title}</h1>
        <a href="/contacto" data-motion-reveal-item>Recibe más información</a>
    </div>
</section>

<style>
    .hero {
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        max-width: 100%;
        height: 350px;
        isolation: isolate;
        background: transparent;
        clip-path: inset(0);
    }

    .viewport-image {
        position: fixed;
        inset-inline: 0;
        bottom: 0;
        height: 1280px;
        pointer-events: none;
        z-index: 0;
    }

    .viewport-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
    }

    .hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background: rgb(0 0 0 / 12%);
        z-index: 1;
    }

    .hero-text {
        position: absolute;
        display: flex;
        flex-direction: column;
        margin: 0 1rem;
        align-items: center;
        gap: 8px;
        text-align: center;
        color: var(--gray-900);
        z-index: 2;
    }

    .hero-text h1 {
        font-size: 60px;
        line-height: 72px;
        margin: 0;
        font-weight: 700;
    }

    .hero-text h2 {
        font-size: 2rem;
        margin: 0;
        font-weight: 500;
    }

    a {
        background-color: var(--red-200);
        color: var(--gray-900);
        border-radius: 999px;
        box-sizing: border-box;
        height: 34px;
        padding: 9px 12px 7px;
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 1px;
        width: 220px;
        line-height: 16px;
        white-space: nowrap;
        text-decoration: none;
    }

    a:hover {
        background-color: var(--red-100);
    }

    @media (max-width: 800px) {
        .hero {
            height: min(68svh, 460px);
            min-height: 360px;
        }

        .hero-text h1 {
            font-size: 9vw;
            line-height: 1.15;
        }

        .viewport-image {
            position: absolute;
            inset: 0;
            height: auto;
        }

    }

    @media (max-width: 450px) {
        .hero-text h1 {
            font-size: 8.7vw;
        }
    }

    @media (max-width: 360px) {
        .hero-text h1 {
            font-size: 2rem;
        }
    }
</style>
