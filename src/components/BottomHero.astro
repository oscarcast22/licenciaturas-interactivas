---
interface Props {
	title: string;
    img1: string;
}

const { title, img1 } = Astro.props;
---
<div>
    <div class="background"></div>
    <div class="hero">
        <div 
            class="hero-text"
        >
            <h1>{title}</h1>
            <a href="/contacto" >Recibe más información</a>
        </div>
        <div class="image">
            <img src={img1} alt="Imagen 1">
        </div>
    </div>
</div>

<style>
    .hero {
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        max-width: 100%;
        overflow: hidden;
        height: 45vh;
    }

    .image {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
    }

    .hero-text {
        position: absolute;
        display: flex;
        flex-direction: column;
        margin: 0 1rem;
        align-items: center;
        gap: 8px;
        text-align: center;
        color: var(--gray-900);
        z-index: 2;
    }

    .hero-text h1 {
        font-size: 3rem;
        margin: 0;
    }

    .hero-text h2 {
        font-size: 2rem;
        margin: 0;
        font-weight: 500;
    }

    .background {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: #00000040;
        pointer-events: none;
        z-index: 1;
    }

    a {
        background-color: var(--red-200);
        color: var(--gray-900);
        padding: 6px 12px;
        font-size: var(--text-base);
        font-weight: 450;
        width: 250px;
        text-decoration: none;
    }

    a:hover {
        background-color: var(--red-100);
    }

    @media (max-width: 450px) {
        .hero-text h1 {
            font-size: 8.7vw;
        }
    }

    @media (max-width: 360px) {
        .hero-text h1 {
            font-size: 2rem;
        }
    }
</style>
