<style>
    .image-container-bottom {
        position: relative;
        width: 100%;
    }

    .image-fade {
        position: relative;
        width: 100%;
        height: 300px;
        overflow: hidden;
    }

    .image-fade img {
        position: absolute;
        width: 100%;
        height: 300px;
        object-fit: cover;
        opacity: 0;
        transition: opacity 1s ease-in-out;
    }

    .image-fade img.active {
        opacity: 1;
    }

    .overlay {
        position: absolute;
		display: flex;
		padding: 25px 35px;
        bottom: 0;
        left: 0;
        right: 0;
		gap: 10px;
    }

    .overlay svg {
        width: 4.5em;
		fill: var(--gray-900);
		transition: width .2s ease;
    }

	.overlay h2 {
		text-transform: uppercase;
		color: var(--gray-900);
		margin: 0;
		font-size: 2em;
		line-height: 1;
	}

    @media (max-width: 541px) {
		.overlay {
			padding: 15px 15px;
		} 
		.overlay svg {
        	width: 6em;
    	}
		.overlay h2 {
			font-size: 6.5vw;
		}
	}
</style>

<script>
    document.addEventListener('astro:page-load', () => {
        const images = document.querySelectorAll('.image-fade img');
        let currentIndex = 0;
        
        function showNextImage() {
            images[currentIndex].classList.remove('active');
            currentIndex = (currentIndex + 1) % images.length;
            images[currentIndex].classList.add('active');
        }

        images[currentIndex].classList.add('active');
        setInterval(showNextImage, 3500);
    });
</script>