<div class="banner" data-image-rotator>
    <div class="image-container-bottom">
        <div class="image-fade">
            <img src="/images/banner-lic-li-uad.jpg" alt="">
            <img src="/images/banner-lic-li-uad-2.jpg" alt="">
            <img src="/images/banner-lic-li-uad-3.jpg" alt="">
        </div>
        <div class="info-button" data-motion-reveal>
            <h1 data-motion-reveal-item>¡Únete a la Gran Familia Lobos!</h1>
            <a href="/contacto" data-motion-reveal-item>
                Recibe Más Información
            </a>
        </div>
    </div>
</div>

<style>
    .image-container-bottom {
        position: relative;
        width: 100%;
    }

    .image-fade {
        position: relative;
        width: 100%;
        height: clamp(250px, 30vw, 360px);
        border-radius: 16px;
        overflow: hidden;
    }

    .image-fade img {
        position: absolute;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        transition: opacity 800ms var(--ease-standard);
    }

    .image-fade img.active {
        opacity: 1;
    }

    .info-button {
        position: absolute;
        top: 50%;
        left: 50%;
        width: min(90%, 760px);
        transform: translate(-50%, -50%);
        text-align: center;
    }

    .info-button h1 {
        color: var(--gray-950);
        font-size: clamp(1.8rem, 4vw, 3.25rem);
        margin: 0 0 1rem;
    }

    .info-button a {
        padding: .75rem 1.25rem;
        margin: auto;
        text-decoration: none; 
        display: inline-block;
        color: var(--gray-950);
        font-weight: 400;
        font-size: 1rem;
        background-color: var(--red-200);
        border-radius: 999px;
    }

    .info-button a:hover {
        background-color: var(--red-100);
    }

    @media (max-width: 288px) {
        .info-button a {
            width: 120px;
        }
    }
</style>

<script>
    let rotatorController: AbortController | undefined;

    document.addEventListener('astro:page-load', () => {
        rotatorController?.abort();
        rotatorController = new AbortController();
        const { signal } = rotatorController;
        const rotator = document.querySelector<HTMLElement>('[data-image-rotator]');
        if (!rotator) return;

        const images = [...rotator.querySelectorAll<HTMLImageElement>('.image-fade img')];
        if (images.length < 2) return;
        let currentIndex = 0;
        let interval: ReturnType<typeof window.setInterval> | undefined;
        let inViewport = false;
        const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

        const showNextImage = () => {
            images[currentIndex].classList.remove('active');
            currentIndex = (currentIndex + 1) % images.length;
            images[currentIndex].classList.add('active');
        };
        const stop = () => {
            if (interval) window.clearInterval(interval);
            interval = undefined;
        };
        const start = () => {
            if (!interval && inViewport && !document.hidden && !motionQuery.matches) {
                interval = window.setInterval(showNextImage, 5500);
            }
        };

        images[currentIndex].classList.add('active');
        const observer = new IntersectionObserver(([entry]) => {
            inViewport = entry.isIntersecting;
            inViewport ? start() : stop();
        }, { threshold: 0.5 });
        observer.observe(rotator);
        document.addEventListener('visibilitychange', () => document.hidden ? stop() : start(), { signal });
        motionQuery.addEventListener('change', () => motionQuery.matches ? stop() : start(), { signal });
        signal.addEventListener('abort', () => {
            stop();
            observer.disconnect();
        }, { once: true });
        document.addEventListener('astro:before-swap', () => rotatorController?.abort(), { once: true });
    });
</script>
