<div 
    class="banner"
    data-aos="fade-in"
    data-aos-duration="350"
    data-aos-offset="200"
    data-aos-once="true"
>
    <div class="image-container-bottom">
        <div class="image-fade">
            <img src="/images/banner-lic-li-uad.jpg" alt="">
            <img src="/images/banner-lic-li-uad-2.jpg" alt="">
            <img src="/images/banner-lic-li-uad-3.jpg" alt="">
        </div>
        <div class="info-button">
            <h1>¡Únete a la Gran Familia Lobos!</h1>
            <a href="/contacto">
                Recibe Más Información
            </a>
        </div>
    </div>
</div>

<style>
    .image-container-bottom {
        position: relative;
        width: 100%;
    }

    .image-fade {
        position: relative;
        width: 100%;
        height: 300px;
        overflow: hidden;
    }

    .image-fade img {
        position: absolute;
        width: 100%;
        height: 300px;
        object-fit: cover;
        opacity: 0;
        transition: opacity 1s ease-in-out;
    }

    .image-fade img.active {
        opacity: 1;
    }

    .info-button {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 90%;
        transform: translate(-50%, -50%);
        text-align: center;
        transition: transform .2s ease;
    }

    .info-button h1 {
        color: var(--gray-950);
    }

    .info-button a {
        padding: 8px 15px; 
        margin: auto;
        text-decoration: none; 
        display: inline-block;
        color: var(--gray-950);
        font-weight: 400;
        font-size: 1rem;
        background-color: var(--red-200);
    }

    .info-button a:hover {
        background-color: var(--red-100);
    }

    @media (max-width: 288px) {
        .info-button a {
            width: 120px;
        }
    }
</style>

<script>
    document.addEventListener('astro:page-load', () => {
        const images = document.querySelectorAll('.image-fade img');
        let currentIndex = 0;
        
        function showNextImage() {
            images[currentIndex].classList.remove('active');
            currentIndex = (currentIndex + 1) % images.length;
            images[currentIndex].classList.add('active');
        }

        images[currentIndex].classList.add('active');
        setInterval(showNextImage, 3500);
    });
</script>