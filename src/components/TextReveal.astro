---
interface Props {
  text?: string;
}

const { text } = Astro.props;

const words = text.split(" ");
---
<div class="text-reveal" data-text-reveal>
  <div class="text-container">
    {words.map((word, index) =>
        index < words.length - 1 ? <span class="word">{word}&nbsp;</span> : <span class="word">{word}</span>
    )}
  </div>
</div>

<style>
  .text-reveal {
    position: relative;
    height: 30vh;
    margin: 2rem 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .text-container {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 20px;
    font-size: 40px;
    font-weight: bold;
    line-height: 1.4;
    text-align: center;
  }

  .word {
    display: inline-block;
    opacity: 1;
    text-transform: uppercase;
    color: var(--gray-300);
  }

  .text-reveal.is-enhanced .word {
    opacity: 0.15;
    will-change: opacity;
  }

  @media screen and (max-width: 760px) {
    .text-container {
        font-size: 5.2vw;
    }
  }

  @media screen and (max-width: 500px) {
    .text-container {
        font-size: 5vw;
    }
  }

  @media screen and (max-width: 350px) {
    .text-container {
        font-size: 4.8vw;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);
  let revealContext: gsap.Context | undefined;

  document.addEventListener('astro:page-load', () => {
    revealContext?.revert();
    const reveal = document.querySelector<HTMLElement>('[data-text-reveal]');
    if (!reveal || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    reveal.classList.add('is-enhanced');
    revealContext = gsap.context(() => {
      gsap.to(reveal.querySelectorAll('.word'), {
        opacity: 1,
        stagger: 0.08,
        ease: 'none',
        scrollTrigger: {
          trigger: reveal,
          start: 'top 62%',
          end: 'bottom 38%',
          scrub: 0.45,
        },
      });
    }, reveal);

    document.addEventListener('astro:before-swap', () => revealContext?.revert(), { once: true });
  });
</script>
