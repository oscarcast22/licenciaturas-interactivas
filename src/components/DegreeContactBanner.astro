---
interface Props {
	color: string;
}

const { color } = Astro.props;
---

<section class="degree-contact" style={`--degree-color: ${color};`}>
	<div class="viewport-image" aria-hidden="true">
		<img src="/images/banner-contacto.jpg" alt="" />
	</div>
	<div class="degree-contact__content">
		<a href="/contacto">Recibe más información</a>
	</div>
</section>

<style>
	.degree-contact {
		--contact-height: 350px;
		--contact-image-height: 503px;
		--contact-parallax-overscan: 165px;
		position: relative;
		display: grid;
		align-items: center;
		height: var(--contact-height);
		isolation: isolate;
		overflow: clip;
		background: transparent;
		clip-path: inset(0);
	}

	.viewport-image {
		position: fixed;
		inset-inline: 0;
		bottom: 0;
		height: calc(var(--contact-image-height) + var(--contact-parallax-overscan));
		pointer-events: none;
		z-index: 0;
	}

	.viewport-image::after {
		content: '';
		position: absolute;
		inset: 0;
		background: rgb(0 0 0 / 12%);
	}

	.viewport-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.degree-contact__content {
		position: relative;
		box-sizing: border-box;
		width: min(100%, var(--page-width));
		margin: 0 auto;
		z-index: 1;
	}

	.degree-contact a {
		display: grid;
		place-items: center;
		box-sizing: border-box;
		width: 250px;
		min-height: 39px;
		margin-left: 19.17%;
		padding: 8px 12px;
		border-radius: 20px;
		background: var(--gray-950);
		color: var(--degree-color);
		font-size: var(--text-base);
		font-weight: 400;
		letter-spacing: 0.03em;
		line-height: 1.2;
		text-align: center;
		text-decoration: none;
		white-space: nowrap;
		transition: background-color 0.5s ease, color 0.5s ease;
	}

	.degree-contact a:hover {
		background: var(--degree-color);
		color: var(--gray-950);
	}

	@media (max-width: 800px) {
		.degree-contact {
			--contact-height: 213px;
			--contact-image-height: auto;
			--contact-parallax-overscan: 0px;
		}

		.viewport-image {
			position: absolute;
			inset: -32px 0;
			height: auto;
		}

		.degree-contact__content {
			width: 100%;
		}

		.degree-contact a {
			margin-left: 17.11%;
		}
	}

	@supports (animation-timeline: view()) {
		@media (max-width: 800px) and (prefers-reduced-motion: no-preference) {
			.viewport-image {
				animation: degree-contact-parallax linear both;
				animation-timeline: view();
				animation-range: entry 0% exit 100%;
			}
		}
	}

	@keyframes degree-contact-parallax {
		from {
			transform: translateY(32px);
		}

		to {
			transform: translateY(-32px);
		}
	}

	@media (max-width: 320px) {
		.degree-contact a {
			width: calc(100% - 40px);
			margin-inline: 20px;
		}
	}
</style>
