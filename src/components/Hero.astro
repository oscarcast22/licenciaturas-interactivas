---
interface Props {
	title: string;
    subtitle: string;
    img1: string;
}

const { title, subtitle, img1 } = Astro.props;
---
<div class="hero-container" id="hero">
    <div class="slider">
        <div class="slide-text" data-motion-load-group>
            <h1 data-motion-load-item>{title}</h1>
            <h2 data-motion-load-item>{subtitle}</h2>
            <a href="/#licenciaturas" data-motion-load-item>Conoce nuestra oferta educativa</a>
        </div>
        <div class="slide-image">
            <img src={img1} alt="Imagen 1" data-motion-load-media>
        </div>
    </div>
</div>

<style>
    .hero-container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        z-index: 0;
    }

    .slider {
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        max-width: 100%;
        overflow: hidden;
        height: 1083px;
    }


    .slide-image {
        position: relative;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .slide-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
    }

    .slide-image::after {
        content: '';
        position: absolute;
        inset: 0;
        background: rgb(0 0 0 / 12%);
    }

    .slide-text {
        position: absolute;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        color: var(--gray-900);
        z-index: 2;
        width: min(980px, calc(100% - 2rem));
        margin: 0 1rem;
    }

    .slide-text h1 {
        font-size: 72px;
        font-weight: 700;
        letter-spacing: normal;
        margin: 0;
    }

    .slide-text h2 {
        font-size: 16px;
        text-wrap: wrap;
        width: 100%;
        margin: auto;
        font-weight: 400;
    }


    a {
        background-color: var(--red-200);
        color: var(--gray-900);
        width: fit-content;
        text-decoration: none;
        border: none;
        border-radius: 15px;
        padding: 9px 20px 7px;
        box-shadow: none;
        cursor: pointer;
        font-size: 14px;
        font-weight: 300;
        letter-spacing: 1px;
        z-index: 3;
        margin-top: 17px;
    }

    a:hover {
        background-color: var(--red-100);
    }

    @media (max-width: 800px) {
        .slider { height: min(100svh, 700px); min-height: 540px; }
        .slide-text h1 {
            font-size: 9vw;
        }
        .slide-text h2 {
            font-size: 1rem;
        }
        .slide-text a {
            font-size: var(--text-sm);
        }
    }

    @media (min-width: 1220px) {
        .slide-text h2 {
            width: 50%;
        }
    }

    @media (max-width: 600px) {
        .slider { min-height: 500px; }
        .slide-text h1 {
            font-size: 2.8rem;
        }
    }

    @media (max-width: 330px) {
        .slide-text h1 {
            font-size: 2.2rem;
        }
    }

</style>
