---
interface Props {
    portada: string;
    portada_alt: string;
}

const { portada, portada_alt } = Astro.props;
---
<div class="banner-container" id="banner">
    <img
        src={portada}
        alt={portada_alt}
        loading="eager"
    />
</div>

<style>
    .banner-container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        z-index: -1;
    }

    .banner-container::after {
        content: '';
        position: absolute;
        inset: 0;
        background: rgb(0 0 0 / 50%);
        pointer-events: none;
    }

    .banner-container img {
        object-fit: cover;
        width: 100%;
        height: 608px;
        object-position: center;
    }

    @media (max-width: 850px) {
        .banner-container img {
            height: min(72svh, 608px);
        }
    }
</style>
