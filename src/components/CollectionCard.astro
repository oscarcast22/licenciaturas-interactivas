---
interface Props {
    title: string;
    imageUrl: string;
    textAlign: string;
    id: string;
    items: Array<{ id: string, collection: string, data: { titulo?: string, color?: string, [key: string]: any } }>;
}

const { title, imageUrl, textAlign, id, items } = Astro.props;

const sortedItems = items.sort((a, b) => {
  let tituloA = a.data.titulo || '';
  let tituloB = b.data.titulo || '';
  return tituloA.localeCompare(tituloB);
});
---
<div
    class="collection-card"
    id={id}
>
    <div class="summary">
        <input type="checkbox" id={`collapse-${title}`} class="collapse-checkbox">
        <label for={`collapse-${title}`}>
            <div class="card">
                <img src={imageUrl} alt={`imagen de ${title}`}>
                <div
                    class:list={[
                        'overlay',
                        textAlign === 'right' ? 'stripe-left' : 'stripe-right',
                    ]}
                >
                    <p>{title}</p>
                </div>
            </div>
        </label>
    </div>
    <div class="details">
        <ul>
            {
                sortedItems.map((item) => (
                    <li transition:name={item.data.titulo}>
                        <a 
                            href={`/${item.collection}/${item.id}`}
                        >
                            {item.data.titulo}
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</div>

<style>
    .collection-card {
        scroll-margin-top: 110px;
        margin: 0 0 34px;
    }

    .summary {
        max-width: 994px;
        margin: 0 auto;
        cursor: pointer;
    }

    .card {
        position: relative;
        border-radius: 0;
        box-shadow: none;
        overflow: hidden;
    }

    .card::before {
        content: '';
        position: absolute;
        inset: 0 0 84px;
        background: rgb(0 0 0 / 42%);
        z-index: 1;
        pointer-events: none;
    }

    input {
        display: none;
    }

    label {
        cursor: pointer;
    }

    .card img {
        width: 100%;
        height: 451px;
        object-fit: cover;
        transition: transform var(--motion-base) var(--ease-standard);
        
    }

    .card:hover img {
        transform: scale(1.02);
    }

    .overlay {
        position: absolute;
        bottom: 0;
        height: 84px;
        background: var(--gray-100);
        display: flex;
        align-items: center;
        width: calc(100% - 15px);
        z-index: 2;
    }

    .stripe-left { left: 15px; justify-content: flex-start; }
    .stripe-right { left: 0; justify-content: flex-end; }

    .stripe-left::before,
    .stripe-right::after {
        content: '';
        position: absolute;
        top: 0;
        width: 15px;
        height: 84px;
        background: var(--red-200);
    }

    .stripe-left::before { left: -15px; }
    .stripe-right::after { right: -15px; }

    .overlay p {
        color: var(--gray-900);
        font-size: 45px;
        line-height: 54px;
        margin: 0 35px;
        font-weight: 400;
    }

    .details {
        height: 0;
        margin: 0 auto;
        overflow: hidden;
        max-width: 994px;
        background-color: var(--surface);
        border-radius: 0;
        box-shadow: none;
        transition: height var(--motion-expand) var(--ease-standard);
    }

    .details ul {
        margin: 0;
        columns: 2;
        column-gap: 3rem;
        padding: 14px 13px 37px;
    }

    .details li {
        break-inside: avoid;
        margin: 0 0 .65rem;
        list-style: none;
    }

    .details a {
        text-decoration: none;
        color: var(--ink-muted);
        font-weight: 300;
        transition: color var(--motion-base) var(--ease-standard);
        font-size: 16px;
    }

    .details a:hover {
        color: var(--red-200);
    }


    @media (min-width: 50em) {
        .details a {
            font-size: 16px;
        }
    }

    @media (max-width: 600px) {
        .card img { height: 270px; }
        .card::before { inset-bottom: 64px; }
        .overlay { height: 64px; width: calc(100% - 10px); }
        .stripe-left { left: 10px; }
        .stripe-left::before,
        .stripe-right::after { width: 10px; height: 64px; }
        .stripe-left::before { left: -10px; }
        .stripe-right::after { right: -10px; }
        .overlay p { font-size: 32px; line-height: 1; margin: 0 20px; }
        .details ul { columns: 1; padding: 1.25rem; }
    }
</style>

<script>
    document.addEventListener('astro:page-load', () => {
        const cards = document.querySelectorAll<HTMLElement>('.collection-card');

        cards.forEach((card) => {
            const checkbox = card.querySelector<HTMLInputElement>('.collapse-checkbox');
            const collapsibleContent = card.querySelector<HTMLElement>('.details');
            if (!checkbox || !collapsibleContent) return;

            let transitionToken = 0;
            let clearTransitionEnd: (() => void) | undefined;
            const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

            const setHeight = (open: boolean) => {
                clearTransitionEnd?.();
                const token = ++transitionToken;
                const startHeight = collapsibleContent.getBoundingClientRect().height;
                const endHeight = open ? collapsibleContent.scrollHeight : 0;

                if (reducedMotion.matches) {
                    collapsibleContent.style.height = open ? 'auto' : '0';
                    return;
                }

                collapsibleContent.style.height = `${startHeight}px`;
                collapsibleContent.getBoundingClientRect();
                requestAnimationFrame(() => {
                    if (token === transitionToken) collapsibleContent.style.height = `${endHeight}px`;
                });

                const finish = (event: TransitionEvent) => {
                    if (event.target !== collapsibleContent || event.propertyName !== 'height' || token !== transitionToken) return;
                    clearTransitionEnd?.();
                    if (open) collapsibleContent.style.height = 'auto';
                };
                clearTransitionEnd = () => {
                    collapsibleContent.removeEventListener('transitionend', finish);
                    clearTransitionEnd = undefined;
                };
                collapsibleContent.addEventListener('transitionend', finish);
            };

            checkbox.addEventListener('change', () => setHeight(checkbox.checked));
            collapsibleContent.style.height = '0';
        });
    });
</script>
